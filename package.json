{
  "name": "tailwind-converter",
  "private": true,
  "description": "Convert CSS to Tailwind utility classes. The conversion map is generated from the installed Tailwind release, not hand-maintained.",
  "version": "1.0.0",
  "author": "Steven Jin",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/view": "^6.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.2",
    "culori": "^4.0.2",
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-postcss": "^6.16.0",
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build:map": "node scripts/build-map.mjs",
    "prebuild": "npm run build:map",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "format": "prettier --write \"{src,scripts}/**/*.{js,mjs,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stevezease/tailwind-converter"
  },
  "bugs": {
    "url": "https://github.com/stevezease/tailwind-converter/issues"
  },
  "keywords": [
    "tailwind",
    "css",
    "converter"
  ]
}
